# Configuración del entorno de producción y desarrollo
# Renombra este archivo a .env y rellena tus datos

# Base de datos (PostgreSQL en la nube para Vercel / Supabase, o deja vacío para fallback a SQLite local)
# NOTA: No incluyas '?pgbouncer=true' en la URL para SQLAlchemy / psycopg2
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres

# Asistente de IA (Groq o Google Gemini)
GROQ_API_KEY=tu_clave_groq_aqui
GEMINI_API_KEY=tu_clave_gemini_aqui

# Credenciales de acceso a UBIKO Web para bot Playwright
UBIKO_URL=https://admin.ubikosports.com
UBIKO_USER=tu_usuario_ubiko
UBIKO_PASSWORD=tu_password_ubiko
